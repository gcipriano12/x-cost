# Configurações para Cloud Native Optimization Service
# Copie este arquivo para .env e configure as credenciais necessárias

# ============================================================================
# Redis Configuration
# ============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ============================================================================
# AWS Configuration
# ============================================================================
AWS_OPTIMIZATION_ENABLED=true
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_DEFAULT_REGION=us-east-1

# ============================================================================
# Azure Configuration
# ============================================================================
AZURE_OPTIMIZATION_ENABLED=true
AZURE_SUBSCRIPTION_ID=your_azure_subscription_id
AZURE_TENANT_ID=your_azure_tenant_id
AZURE_CLIENT_ID=your_azure_client_id
AZURE_CLIENT_SECRET=your_azure_client_secret

# ============================================================================
# Google Cloud Configuration
# ============================================================================
GCP_OPTIMIZATION_ENABLED=true
GCP_PROJECT_ID=your_gcp_project_id
GOOGLE_APPLICATION_CREDENTIALS=/path/to/gcp-service-account.json

# ============================================================================
# Oracle Cloud Configuration
# ============================================================================
ORACLE_OPTIMIZATION_ENABLED=false
OCI_CONFIG_FILE=/path/to/oci-config

# ============================================================================
# Cache TTL Settings (optional, defaults provided)
# ============================================================================
ANOMALIES_CACHE_TTL=3600
SAVINGS_CACHE_TTL=14400
RECOMMENDATIONS_CACHE_TTL=21600
