# Configuração para usar LocalStack com o backend
# Copie este arquivo para .env para usar LocalStack

# Configurações do banco de dados
DATABASE_URL=postgresql://finops_user:finops_password@localhost:5432/finops_db

# Configurações do Redis
REDIS_URL=redis://localhost:6379/0

# Configurações da aplicação
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=DEBUG
FINOPS_SECRET_KEY=dev-secret-key-not-for-production-use-only

# Configurações AWS para LocalStack
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=us-east-1

# Configuração específica para Cloud Optimization
CLOUD_OPTIMIZATION_ENABLED=true
CLOUD_OPTIMIZATION_AWS_ENABLED=true
CLOUD_OPTIMIZATION_AZURE_ENABLED=false
CLOUD_OPTIMIZATION_GCP_ENABLED=false
CLOUD_OPTIMIZATION_ORACLE_ENABLED=false

# Cache Redis TTL (em segundos)
CLOUD_OPTIMIZATION_CACHE_ANOMALIES_TTL=3600
CLOUD_OPTIMIZATION_CACHE_SAVINGS_TTL=14400
CLOUD_OPTIMIZATION_CACHE_RECOMMENDATIONS_TTL=21600

# Rate limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600

# JWT configurações
JWT_SECRET_KEY=super-secret-jwt-key-for-development-only
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
