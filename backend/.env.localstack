# Configuração para LocalStack
# Copie para .env ou use: source .env.localstack

ENVIRONMENT=development
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Configurações adicionais do LocalStack
LOCALSTACK_HOST=localhost
LOCALSTACK_PORT=4566

# Para aplicação X-Cost
JWT_SECRET_KEY=your-dev-secret-key-here
DATABASE_URL=postgresql://finops_user:finops_password@localhost:5432/finops_db
EOF < /dev/null